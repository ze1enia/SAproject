# Copy this file to .env and adjust the values for your machine:  cp .env.example .env
# .env is private to each person and is NOT committed (see .gitignore).

# 5000 is taken by AirPlay Receiver on macOS, so the backend uses 5001
PORT=5001

# Secret used to sign login tokens - use your own long random string
JWT_SECRET=change_me_to_a_long_random_string

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=saproject_db
DB_PORT=3306
